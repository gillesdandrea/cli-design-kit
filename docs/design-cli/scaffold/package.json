{
  "name": "demo-cli",
  "version": "0.1.0",
  "description": "A CLI scaffolded with /design-cli — agent-ready by default.",
  "type": "module",
  "bin": {
    "demo-cli": "./dist/demo-cli"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build --compile --target=bun src/cli.ts --outfile dist/demo-cli",
    "audit": "bun run ../../../tools/design-cli-verify/src/verify.ts ./.design-cli-verify.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
